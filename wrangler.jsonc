{
  // 리액션 길드 — Cloudflare Workers + Durable Objects (SQLite) + Static Assets
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reaction-guild",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/ws", "/ws/*"]
  },
  "vars": {
    // TEACHER_PASSWORD_SECRET must be provisioned using wrangler secret put.
    "TEACHER_ID": "teacher",
    "ENVIRONMENT": "production"
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOM", "class_name": "RoomDurableObject" },
      { "name": "DIRECTORY", "class_name": "DirectoryDurableObject" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomDurableObject", "DirectoryDurableObject"] }
  ],
  "env": {
    "staging": {
      "name": "reaction-guild-staging",
      "vars": { "TEACHER_ID": "teacher", "ENVIRONMENT": "staging" },
      "durable_objects": {
        "bindings": [
          { "name": "ROOM", "class_name": "RoomDurableObject" },
          { "name": "DIRECTORY", "class_name": "DirectoryDurableObject" }
        ]
      }
    }
  }
}
